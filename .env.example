# Every environment variable set for Potato, with no values.
# The POSTGRES_* and PG* groups come from the Neon integration on Vercel.
# Never commit real values. Local work uses two files:
#   .env.local              every variable, with the production database (neondb)
#                           (what `vercel env pull` writes).
#   .env.development.local  only the database variables, pointed at potato_dev.
#                           `next dev`, `bun run db:migrate`, and the dev login use it.
# `bun run db:migrate:prod` is the only local command meant to reach neondb.

# Neon Postgres: connection strings (pooled and direct)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Postgres: Vercel integration variables (POSTGRES_* form)
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_URL_NO_SSL=
POSTGRES_PRISMA_URL=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Neon Postgres: libpq-style variables (PG* form)
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGDATABASE=
PGPASSWORD=

# Neon project
NEON_PROJECT_ID=

# Better Auth: the secret signs session cookies (32+ random bytes, base64).
# The URL is the app origin: http://localhost:3000 locally, the production
# domain on Vercel production. Unset on preview, where sign-in is not expected.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Google sign-in (OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TMDB API (read access token)
TMDB_API_READ_TOKEN=

# Vercel system variables: Vercel sets these on every deployment. Leave empty locally.
VERCEL_GIT_COMMIT_SHA=
VERCEL_ENV=
