# Every environment variable set for Potato, with no values.
# The POSTGRES_* and PG* groups come from the Neon integration on Vercel.
# Copy to .env.local for local work. Never commit real values.

# Neon Postgres: connection strings (pooled and direct)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Postgres: Vercel integration variables (POSTGRES_* form)
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_URL_NO_SSL=
POSTGRES_PRISMA_URL=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Neon Postgres: libpq-style variables (PG* form)
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGDATABASE=
PGPASSWORD=

# Neon project
NEON_PROJECT_ID=

# Better Auth: the secret signs session cookies (32+ random bytes, base64).
# The URL is the app origin: http://localhost:3000 locally, the production
# domain on Vercel production. Unset on preview, where sign-in is not expected.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Google sign-in (OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TMDB API (read access token)
TMDB_API_READ_TOKEN=

# Vercel Cron: Vercel sends "Authorization: Bearer <CRON_SECRET>" to cron routes.
# Production only (crons never run on previews). Letters and digits, no newline.
CRON_SECRET=

# Vercel system variables: Vercel sets these on every deployment. Leave empty locally.
VERCEL_GIT_COMMIT_SHA=
VERCEL_ENV=
