      "uniqueConstraints": {},
      "policies": {},
      "checkConstraints": {
        "title_status_media_type_check": {
          "name": "title_status_media_type_check",
          "value": "\"title_status\".\"media_type\" in ('movie', 'tv')"
        },
        "title_status_tmdb_id_check": {
          "name": "title_status_tmdb_id_check",
          "value": "\"title_status\".\"tmdb_id\" > 0"
        },
        "title_status_status_check": {
          "name": "title_status_status_check",
          "value": "\"title_status\".\"status\" in ('watchlist', 'passed', 'seen', 'skipped')"
        },
        "title_status_rating_scale_check": {
          "name": "title_status_rating_scale_check",
          "value": "\"title_status\".\"rating\" is null or (\"title_status\".\"rating\" between 0.5 and 5 and \"title_status\".\"rating\" * 2 = trunc(\"title_status\".\"rating\" * 2))"
        },
        "title_status_rating_iff_seen_check": {
          "name": "title_status_rating_iff_seen_check",
          "value": "(\"title_status\".\"status\" = 'seen') = (\"title_status\".\"rating\" is not null)"
        },
        "title_status_review_only_seen_check": {
          "name": "title_status_review_only_seen_check",
          "value": "\"title_status\".\"review\" is null or \"title_status\".\"status\" = 'seen'"
        },
        "title_status_review_visibility_check": {
          "name": "title_status_review_visibility_check",
          "value": "\"title_status\".\"review_visibility\" in ('private')"
        },
        "title_status_skip_until_iff_skipped_check": {
          "name": "title_status_skip_until_iff_skipped_check",
          "value": "(\"title_status\".\"status\" = 'skipped') = (\"title_status\".\"skip_until\" is not null)"
        }
      },
      "isRLSEnabled": false
    },
