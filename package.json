{
  "name": "potato",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint",
    "test": "bun test --no-env-file",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --no-env-file scripts/migrate.ts dev",
    "db:migrate:prod": "bun --no-env-file scripts/migrate.ts prod"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bun": "^1.4.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "bun@1.3.5",
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
